- var x = 1
if x {
  p yes
} else {
  p no
}
each item in items {
  li= item
}
mixin card {
  .card
}
+card
extends layout
block content {
  p hi
}
p!= html
div&attributes(attrs)
:markdown
include partials/item
include:md readme.md
<div class="raw">
  <span>html</span>
</div>
p #[b old] interpolation
p.
img/
p kept
