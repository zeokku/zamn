a(href=/) Home
a(href=/docs/?q#top target=_blank) Docs
a(href=a+b n=f(1) i=a[0] w=50%) x
input(type=checkbox checked=true hidden=false)
RouterLink(:to=/about :class={ active: onAbout, 'is-new': fresh } @click=go()) About
Table(v-bind=[a, b] #default=(row) .prop=x)
p(style={color: 'red', 'font-size': '12px', margin: 0,}) Styled
p(style={}) Empty style
a(style={color: c}) Bare value
button(style={ fontSize: 1em, 'text-align': 'center', padding: 1rem 0.5rem, transitionProperty: "color, background" }) Casing
div(style={WebkitTransition: none, msFlex: 1, --brand: red, background: url('a,b') rgb(0, 0, 0)})
input(disabled readonly=true required=false)
