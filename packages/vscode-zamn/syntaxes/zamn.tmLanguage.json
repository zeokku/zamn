{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "zamn",
  "scopeName": "source.zamn",
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "comment": "what may start wherever a statement can: on a line, after a `{`, after a `}`",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#doctype"
        },
        {
          "include": "#unsupported"
        },
        {
          "include": "#raw-script"
        },
        {
          "include": "#raw-style"
        },
        {
          "include": "#unmatched-close"
        },
        {
          "include": "#pipe-block"
        },
        {
          "include": "#pipe"
        },
        {
          "include": "#output"
        },
        {
          "include": "#unexpected-text"
        },
        {
          "include": "#element"
        },
        {
          "include": "#block-close"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "/\\*!",
          "end": "\\*/",
          "name": "string.comment.buffered.block.zamn",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.zamn"
            }
          },
          "comment": "emitted as an HTML comment, so it is not coloured as one: the scope pug gives its own"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.zamn",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.zamn"
            }
          },
          "comment": "left out of the output"
        },
        {
          "begin": "//!",
          "end": "$",
          "name": "string.comment.buffered.block.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.zamn"
            }
          },
          "comment": "emitted as an HTML comment, so it is not coloured as one: the scope pug gives its own"
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.zamn"
            }
          },
          "comment": "left out of the output"
        }
      ]
    },
    "doctype": {
      "match": "^[ \\t]*(doctype)\\b[ \\t]*(.*)$",
      "name": "meta.tag.sgml.doctype.zamn",
      "captures": {
        "1": {
          "name": "entity.name.tag.doctype.zamn"
        },
        "2": {
          "name": "string.unquoted.doctype.zamn"
        }
      }
    },
    "unsupported": {
      "comment": "pug syntax that zamn rejects, lines of HTML among it",
      "patterns": [
        {
          "match": "^[ \\t]*((?:if|unless|while|case|when|each|for|mixin|extends?|append|prepend)(?=[ \\t])|(?:else|block)(?=[ \\t]|$)|include(?=[ \\t:]|$)|default(?=[ \\t]*$|:)).*$",
          "captures": {
            "1": {
              "name": "invalid.illegal.unsupported.zamn"
            }
          }
        },
        {
          "match": "^[ \\t]*([-+<]|:[\\w-]).*$",
          "name": "invalid.illegal.unsupported.zamn"
        }
      ]
    },
    "raw-script": {
      "comment": "`script` whose head ends its line: raw source.js lines up to a line that is just `/script`",
      "begin": "^[ \\t]*(script)(?![\\w-]|:\\w)(?!.*[(\\s,](?::|v-bind:)?src(?![\\w-]))(?=(?:[^\\s(){}|=]|\\((?:[^()\"'`]|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|`(?:[^`\\\\]|\\\\.)*`)*\\))*[ \\t]*$)",
      "end": "^[ \\t]*(/)(script)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.zamn"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.zamn"
        },
        "2": {
          "name": "entity.name.tag.zamn"
        }
      },
      "name": "meta.raw.zamn",
      "patterns": [
        {
          "comment": "first, or a line of content that starts like a class, an id or attributes would be taken for one",
          "begin": "^(?![ \\t]*/script[ \\t]*$)",
          "while": "^(?![ \\t]*/script[ \\t]*$)",
          "contentName": "source.js.embedded.zamn",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "include": "#id"
        },
        {
          "include": "#class"
        },
        {
          "include": "#attributes"
        }
      ]
    },
    "raw-style": {
      "comment": "`style` whose head ends its line: raw source.css lines up to a line that is just `/style`",
      "begin": "^[ \\t]*(style)(?![\\w-]|:\\w)(?=(?:[^\\s(){}|=]|\\((?:[^()\"'`]|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|`(?:[^`\\\\]|\\\\.)*`)*\\))*[ \\t]*$)",
      "end": "^[ \\t]*(/)(style)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.zamn"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.zamn"
        },
        "2": {
          "name": "entity.name.tag.zamn"
        }
      },
      "name": "meta.raw.zamn",
      "patterns": [
        {
          "comment": "first, or a line of content that starts like a class, an id or attributes would be taken for one",
          "begin": "^(?![ \\t]*/style[ \\t]*$)",
          "while": "^(?![ \\t]*/style[ \\t]*$)",
          "contentName": "source.css.embedded.zamn",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "include": "#id"
        },
        {
          "include": "#class"
        },
        {
          "include": "#attributes"
        }
      ]
    },
    "unmatched-close": {
      "comment": "a `/tag` line that closes no raw content",
      "match": "^[ \\t]*/[A-Za-z][\\w-]*[ \\t]*$",
      "name": "invalid.illegal.unmatched-close.zamn"
    },
    "block-close": {
      "match": "\\}",
      "name": "punctuation.section.block.end.zamn"
    },
    "block": {
      "comment": "`{` after a tag head, unless it is `{{`: statements up to the matching `}`, on any line",
      "begin": "[ \\t]*(\\{)(?!\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.block.begin.zamn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.zamn"
        }
      },
      "patterns": [
        {
          "include": "#statements"
        }
      ]
    },
    "pipe-block": {
      "comment": "`|{ ... }` and `| { ... }`: text up to the matching `}`, on any line",
      "begin": "[ \\t]*(\\|)[ \\t]*(\\{)(?!\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.text.zamn"
        },
        "2": {
          "name": "punctuation.section.block.begin.zamn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.zamn"
        }
      },
      "patterns": [
        {
          "include": "#inline"
        }
      ]
    },
    "pipe": {
      "comment": "`| text`, and `div | text`: text to the end of the line or the `}` of the parent",
      "begin": "[ \\t]*(\\|)",
      "end": "$|(?=\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.text.zamn"
        }
      },
      "patterns": [
        {
          "include": "#text-start"
        },
        {
          "include": "#inline"
        }
      ]
    },
    "output": {
      "begin": "=",
      "end": "$|(?=\\})",
      "contentName": "source.ts.embedded.zamn",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.output.zamn"
        }
      },
      "patterns": [
        {
          "include": "source.ts#expression"
        },
        {
          "include": "#brackets"
        }
      ]
    },
    "unexpected-text": {
      "comment": "text that does not start with `|`",
      "begin": "(?=\\{\\{|#\\{)",
      "end": "$|(?=\\})",
      "name": "invalid.illegal.unexpected-text.zamn",
      "patterns": [
        {
          "include": "#inline"
        }
      ]
    },
    "element": {
      "comment": "a tag head and what follows it: an element ends after its own `}`, at the end of the line, or before the `}` of its parent",
      "begin": "([A-Za-z][\\w-]*(?::[\\w-]+)*)|(#[\\w-]+)|(\\.(?:(?:[\\w@*%-]|\\[(?:[^\\s{}\\[\\]]|\\[[^\\s{}\\[\\]]*\\])*\\]|(?<=-)\\((?:[^\\s{}()]|\\([^\\s{}()]*\\))*\\)|\\.(?=\\d)|!(?!=)|[:/](?=[\\w@*%\\[-]|!(?!=)|\\.\\d)))*?(?=[A-Za-z_]|\\[[^\\s{}\\]]*[A-Za-z_])(?:(?:[\\w@*%-]|\\[(?:[^\\s{}\\[\\]]|\\[[^\\s{}\\[\\]]*\\])*\\]|(?<=-)\\((?:[^\\s{}()]|\\([^\\s{}()]*\\))*\\)|\\.(?=\\d)|!(?!=)|[:/](?=[\\w@*%\\[-]|!(?!=)|\\.\\d)))+)",
      "end": "(?<=\\})|$|(?=\\})",
      "name": "meta.tag.zamn",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.zamn"
        },
        "2": {
          "name": "entity.other.attribute-name.id.zamn"
        },
        "3": {
          "name": "entity.other.attribute-name.class.zamn"
        }
      },
      "patterns": [
        {
          "include": "#id"
        },
        {
          "include": "#class"
        },
        {
          "include": "#attributes"
        },
        {
          "match": "&attributes\\b",
          "name": "invalid.illegal.unsupported.zamn"
        },
        {
          "comment": "`tag.` and `tag/` are gone",
          "match": "[./](?=[ \\t]*(?:$|\\}))",
          "name": "invalid.illegal.unsupported.zamn"
        },
        {
          "include": "#block"
        },
        {
          "include": "#pipe-block"
        },
        {
          "include": "#pipe"
        },
        {
          "begin": "(:)[ \\t]+",
          "end": "(?<=\\})|$|(?=\\})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.expansion.zamn"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "include": "#output"
        },
        {
          "begin": "[ \\t]+|(?=\\{\\{)",
          "end": "$|(?=\\})",
          "patterns": [
            {
              "include": "#text-start"
            },
            {
              "include": "#inline"
            }
          ]
        }
      ]
    },
    "text-start": {
      "match": "\\G[ \\t]*(\\\\\\|)",
      "captures": {
        "1": {
          "name": "constant.character.escape.zamn"
        }
      }
    },
    "inline": {
      "comment": "text: `{{ }}`, `#{el ...}` and the escapes; a `{` of its own must be escaped",
      "patterns": [
        {
          "match": "\\\\(?:[{}]|#[{\\[])",
          "name": "constant.character.escape.zamn"
        },
        {
          "include": "#mustache"
        },
        {
          "begin": "#\\{",
          "end": "\\}",
          "name": "meta.interpolation.tag.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.zamn"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        },
        {
          "match": "#\\[",
          "name": "invalid.illegal.unsupported.zamn"
        },
        {
          "match": "\\{",
          "name": "invalid.illegal.unescaped-brace.zamn"
        }
      ]
    },
    "mustache": {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "contentName": "source.ts.embedded.zamn",
      "patterns": [
        {
          "include": "source.ts#expression"
        }
      ],
      "name": "meta.interpolation.expression.zamn",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.begin.zamn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.interpolation.end.zamn"
        }
      }
    },
    "id": {
      "match": "#[\\w-]+",
      "name": "entity.other.attribute-name.id.zamn"
    },
    "class": {
      "match": "\\.(?:(?:[\\w@*%-]|\\[(?:[^\\s{}\\[\\]]|\\[[^\\s{}\\[\\]]*\\])*\\]|(?<=-)\\((?:[^\\s{}()]|\\([^\\s{}()]*\\))*\\)|\\.(?=\\d)|!(?!=)|[:/](?=[\\w@*%\\[-]|!(?!=)|\\.\\d)))*?(?=[A-Za-z_]|\\[[^\\s{}\\]]*[A-Za-z_])(?:(?:[\\w@*%-]|\\[(?:[^\\s{}\\[\\]]|\\[[^\\s{}\\[\\]]*\\])*\\]|(?<=-)\\((?:[^\\s{}()]|\\([^\\s{}()]*\\))*\\)|\\.(?=\\d)|!(?!=)|[:/](?=[\\w@*%\\[-]|!(?!=)|\\.\\d)))+",
      "name": "entity.other.attribute-name.class.zamn"
    },
    "attributes": {
      "begin": "\\(",
      "end": "\\)",
      "name": "meta.attributes.zamn",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.attributes.begin.zamn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.attributes.end.zamn"
        }
      },
      "patterns": [
        {
          "begin": "((?:v-|[:@#])[^\\s=,()!]+)(!?=)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.directive.zamn"
            },
            "2": {
              "name": "keyword.operator.assignment.zamn"
            },
            "3": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "name": "meta.attribute.directive.zamn",
          "contentName": "source.ts.embedded.zamn",
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "begin": "((?:v-|[:@#])[^\\s=,()!]+)(!?=)(')",
          "end": "'",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.directive.zamn"
            },
            "2": {
              "name": "keyword.operator.assignment.zamn"
            },
            "3": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "name": "meta.attribute.directive.zamn",
          "contentName": "source.ts.embedded.zamn",
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "begin": "((?:v-|[:@#])[^\\s=,()!]+)(!?=)(`)",
          "end": "`",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.directive.zamn"
            },
            "2": {
              "name": "keyword.operator.assignment.zamn"
            },
            "3": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "name": "meta.attribute.directive.zamn",
          "contentName": "source.ts.embedded.zamn",
          "patterns": [
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "include": "#style-object"
        },
        {
          "comment": "a binding written without quotes: a value in brackets, spaces and all",
          "begin": "((?:v-|[:@#.])[^\\s=,()!]+)(!?=)(?=[{\\[(])",
          "end": "(?<=[}\\])])",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.directive.zamn"
            },
            "2": {
              "name": "keyword.operator.assignment.zamn"
            }
          },
          "name": "meta.attribute.directive.zamn",
          "contentName": "source.ts.embedded.zamn",
          "patterns": [
            {
              "include": "#brackets"
            }
          ]
        },
        {
          "match": "(?:v-|[:@#])[^\\s=,()!]+",
          "name": "entity.other.attribute-name.directive.zamn"
        },
        {
          "match": "(?<!=)[^\\s=,()!\"'`]+(?=!?=|[\\s,)]|$)",
          "name": "entity.other.attribute-name.zamn"
        },
        {
          "match": "!?=",
          "name": "keyword.operator.assignment.zamn"
        },
        {
          "match": ",",
          "name": "punctuation.separator.attribute.zamn"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zamn"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zamn"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.other.zamn",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zamn"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zamn"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zamn"
            }
          ]
        },
        {
          "match": "(?<==)(?:true|false|null|undefined)(?=[\\s,)]|$)",
          "name": "constant.language.zamn"
        },
        {
          "match": "(?<==)-?\\d+(?:\\.\\d+)?(?=[\\s,)]|$)",
          "name": "constant.numeric.zamn"
        },
        {
          "match": "(?<==)[^\\s,)]+",
          "name": "string.unquoted.zamn"
        }
      ]
    },
    "style-object": {
      "comment": "static `style={...}`: CSS declarations, `key: value` separated by commas, keys bare (camelCase or kebab-case) or quoted, values bare CSS or quoted",
      "begin": "(?<![^\\s(,])(style)(=)(\\{)",
      "end": "\\}",
      "name": "meta.attribute.style.zamn",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.zamn"
        },
        "2": {
          "name": "keyword.operator.assignment.zamn"
        },
        "3": {
          "name": "punctuation.section.style.begin.zamn"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.style.end.zamn"
        }
      },
      "patterns": [
        {
          "match": "--[\\w-]+(?=\\s*:)",
          "name": "variable.other.custom-property.zamn"
        },
        {
          "match": "[A-Za-z_$][\\w$-]*(?=\\s*:)",
          "name": "support.type.property-name.zamn"
        },
        {
          "match": "([\"'])((?:(?!\\1)[^\\\\]|\\\\.)*)(\\1)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.begin.zamn"
            },
            "2": {
              "name": "support.type.property-name.zamn"
            },
            "3": {
              "name": "punctuation.definition.string.end.zamn"
            }
          }
        },
        {
          "begin": "(:)[ \\t]*",
          "end": "[ \\t]*(?=[,}])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.separator.key-value.zamn"
            }
          },
          "contentName": "meta.property-value.zamn",
          "patterns": [
            {
              "begin": "\"",
              "end": "\"",
              "name": "string.quoted.double.zamn",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.zamn"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.zamn"
                }
              },
              "patterns": [
                {
                  "match": "\\\\.",
                  "name": "constant.character.escape.zamn"
                }
              ]
            },
            {
              "begin": "'",
              "end": "'",
              "name": "string.quoted.single.zamn",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.zamn"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.zamn"
                }
              },
              "patterns": [
                {
                  "match": "\\\\.",
                  "name": "constant.character.escape.zamn"
                }
              ]
            },
            {
              "include": "source.css#property-values"
            },
            {
              "include": "#style-parens"
            }
          ]
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.zamn"
        }
      ]
    },
    "style-parens": {
      "comment": "balanced, so a `,` inside `rgb(0, 0, 0)` does not end the value",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "begin": "\"",
