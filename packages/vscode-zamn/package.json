{
  "name": "zamn-vscode",
  "displayName": "zamn",
  "version": "1.0.0",
  "description": "Syntax highlighting for zamn templates, in .zamn files and in Vue single-file components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeokku/zamn.git",
    "directory": "packages/vscode-zamn"
  },
  "private": true,
  "publisher": "zeokku",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#212121",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["zamn", "vue", "template"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:vue"],
  "contributes": {
    "languages": [
      {
        "id": "zamn",
        "aliases": ["zamn"],
        "extensions": [".zamn"],
        "icon": {
          "light": "./images/file-icon.png",
          "dark": "./images/file-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zamn",
        "scopeName": "source.zamn",
        "path": "./syntaxes/zamn.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts.embedded.zamn": "typescript",
          "source.js.embedded.zamn": "javascript",
          "source.css.embedded.zamn": "css"
        }
      },
      {
        "scopeName": "zamn.vue-injection",
        "path": "./syntaxes/zamn.vue-injection.tmLanguage.json",
        "injectTo": ["text.html.vue"],
        "embeddedLanguages": {
          "source.zamn": "zamn",
          "source.ts.embedded.zamn": "typescript",
          "source.js.embedded.zamn": "javascript",
          "source.css.embedded.zamn": "css"
        }
      }
    ],
    "configurationDefaults": {
      "better-comments.languages": [
        {
          "id": "vue",
          "comments": { "lineComment": "//", "blockComment": ["<!--", "-->"] }
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p . && bun scripts/build.ts",
    "test": "bun test",
    "package": "bun ../../assets/logo.ts && bun run build && vsce package --no-dependencies",
    "install:local": "bun scripts/install-local.ts"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.0",
    "vscode-textmate": "^9.0.0",
    "zamn": "workspace:*"
  }
}
