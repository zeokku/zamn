{
  "name": "eslint-plugin-vue-zamn",
  "version": "1.0.0",
  "description": "ESLint plugin for zamn templates in Vue single-file components: a config for eslint-plugin-vue, and rules of its own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeokku/zamn.git",
    "directory": "packages/eslint-plugin-vue-zamn"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": ["eslint", "eslintplugin", "eslint-plugin", "vue", "zamn"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "bun test"
  },
  "dependencies": {
    "vue-eslint-parser-template-tokenizer-zamn": "workspace:~",
    "zamn": "workspace:~"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "typescript": "^7.0.2",
    "vue-eslint-parser": "^10.4.0"
  }
}
