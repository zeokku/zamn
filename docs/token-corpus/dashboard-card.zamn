div(class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4") {
  div(v-for="stat in stats" :key="stat.id" class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900") {
    div(class="flex items-center justify-between") {
      p(class="text-sm font-medium text-gray-500 dark:text-gray-400")= stat.label
      span(class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-300") {
        component(:is="stat.icon" class="h-5 w-5" aria-hidden="true")
      }
    }
    p(class="mt-4 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white")= stat.value
    div(class="mt-2 flex items-center gap-2 text-sm") {
      span(:class="stat.change >= 0 ? 'text-emerald-600' : 'text-rose-600'" class="inline-flex items-center font-medium") {
        IconArrowUp(v-if="stat.change >= 0" class="h-4 w-4" aria-hidden="true")
        IconArrowDown(v-else class="h-4 w-4" aria-hidden="true")
        = formatPercent(stat.change)
      }
      span(class="text-gray-500 dark:text-gray-400") vs last month
    }
    div(class="mt-4 h-12") {
      Sparkline(:points="stat.history" :color="stat.change >= 0 ? '#059669' : '#e11d48'")
    }
  }
}
div(class="mt-8 rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900") {
  div(class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-gray-800") {
    h3(class="text-base font-semibold text-gray-900 dark:text-white") Recent activity
    a(href="/activity" class="text-sm font-medium text-indigo-600 hover:text-indigo-500") View all
  }
  ul(role="list" class="divide-y divide-gray-200 dark:divide-gray-800") {
    li(v-for="event in activity" :key="event.id" class="flex items-center gap-4 px-6 py-4") {
      img(:src="event.user.avatar" alt="" class="h-8 w-8 rounded-full")
      div(class="min-w-0 flex-1") {
        p(class="truncate text-sm text-gray-900 dark:text-white") {
          strong(class="font-medium")= event.user.name
          |
          = event.description
        }
        p(class="text-xs text-gray-500") {
          time(:datetime="event.at")= formatRelative(event.at)
        }
      }
    }
  }
}
